{
  "name": "wp-api",
  "version": "2.0.0",
  "author": "JellyDai",
  "description": "MCP server for managing WordPress through native, Jelly Core, Jelly Catalog, and Jelly Form REST APIs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wp-api-mcp": "./build/bin/wp-api-mcp.js"
  },
  "files": [
    "build",
    "README.md",
    "README.zh-CN.md",
    "mcp.md"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-config.mjs",
    "start": "node build/bin/wp-api-mcp.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test",
    "test:unit": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^7.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^24.0.10",
    "typescript": "^5.8.3"
  }
}
