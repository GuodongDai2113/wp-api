{
  "name": "wp-api",
  "version": "2.2.0",
  "author": "JellyDai",
  "license": "MIT",
  "description": "MCP server for managing WordPress through native, Jelly Core, Jelly Catalog, and Jelly Form REST APIs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wordpress",
    "wordpress-rest-api",
    "elementor"
  ],
  "homepage": "https://github.com/GuodongDai2113/wp-api#readme",
  "bugs": {
    "url": "https://github.com/GuodongDai2113/wp-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuodongDai2113/wp-api.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "bin": {
    "wp-api-mcp": "./build/bin/wp-api-mcp.js",
    "wp-api-config": "./build/bin/wp-api-config.js"
  },
  "files": [
    "build",
    "README.md",
    "README.zh-CN.md",
    "mcp.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node build/bin/wp-api-mcp.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test",
    "test:unit": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^7.0.1",
    "parse5": "^7.3.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^24.0.10",
    "@wordpress/block-serialization-default-parser": "^5.53.0",
    "typescript": "^5.8.3"
  }
}
